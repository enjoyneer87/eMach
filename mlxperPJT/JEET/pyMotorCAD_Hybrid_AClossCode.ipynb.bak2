   "source": [
    "# ─────────────────────────────────────────────────────────────────────────────\n",
    "# [4] TXT 파싱 → 도체 RegCode 식별 + 전 속도 파싱 + Hybrid/FullFEA 분류 (Je 기반)\n",
    "# ─────────────────────────────────────────────────────────────────────────────\n",
    "import importlib\n",
    "import tools.motorCAD.pyMCAD.magnetic_model as _mm\n",
    "import tools.motorCAD.pyMCAD.magnetic_plot as _mp\n",
    "import tools.motorCAD.pyMCAD.magnetic_parse as _mparse\n",
    "import tools.motorCAD.pyMCAD.magnetic as _mag\n",
    "importlib.reload(_mm)\n",
    "importlib.reload(_mp)\n",
    "importlib.reload(_mparse)\n",
    "importlib.reload(_mag)\n",
    "\n",
    "from tools.motorCAD.pyMCAD.magnetic import get_magnetic_timeseries_from_file\n",
    "\n",
    "\n",
    "def detect_fea_mode(ts_obj, winding_codes, je_threshold=0.1):\n",
    "    \"\"\"\n",
    "    파싱된 MagneticRegionsTimeSeries에서 Hybrid vs FullFEA 판별.\n",
    "    \n",
    "    판별 기준: 도체(winding) 요소의 Je (eddy current density)\n",
    "      - Hybrid: σ→∞ 근사 → Je ≈ 0\n",
    "      - FullFEA (TS): 실제 eddy current 풀이 → |Je| >> 0\n",
    "    \n",
    "    Args:\n",
    "        ts_obj: MagneticRegionsTimeSeries\n",
    "        winding_codes: winding RegCode 리스트\n",
    "        je_threshold: |Je| 최대값이 이 이상이면 FullFEA로 판별 [A/mm²]\n",
    "    \n",
    "    Returns:\n",
    "        str: \"HYBRID\" or \"FULLFEA\"\n",
    "        float: max |Je| in winding elements\n",
    "    \"\"\"\n",
    "    mr0 = ts_obj.by_step[ts_obj.steps[0]]\n",
    "    je_max = 0.0\n",
    "    n_sampled = 0\n",
    "    for rc in winding_codes:\n",
    "        if rc - 1 >= len(mr0._regions):\n",
    "            continue\n",
    "        reg = mr0._regions[rc - 1]\n",
    "        for el in reg.elements[:50]:  # 첫 50개 샘플\n",
    "            je_max = max(je_max, abs(el.je))\n",
    "            n_sampled += 1\n",
    "    \n",
    "    mode = \"FULLFEA\" if je_max > je_threshold else \"HYBRID\"\n",
    "    return mode, je_max\n",
    "\n",
    "\n",
    "# ── 모델별 전 속도 파일 파싱 + winding RegCode 식별 + Hybrid/FullFEA 분류 ──\n",
    "all_winding_reg_codes = {}  # {model_key: [reg_codes]}\n",
    "all_HybFEA = {}   # {model_key: {speed_rpm: MagneticRegionsTimeSeries}}\n",
    "all_FullFEA = {}  # {model_key: {speed_rpm: MagneticRegionsTimeSeries}}\n",
    "all_fea_modes = {}  # {model_key: {\"hybrid\"|\"fullfea\": {speed_rpm: \"HYBRID\"|\"FULLFEA\"}}}\n",
    "\n",
    "for model_key in [\"ref\", \"halfsc\", \"sc\"]:\n",
    "    ef = all_exported_files.get(model_key, {})\n",
    "    if not ef:\n",
    "        print(f\"\\n[{model_key}] No exported files — skip\")\n",
    "        continue\n",
    "    \n",
    "    # ef = {\"hybrid\": {speed: Path}, \"fullfea\": {speed: Path}}\n",
    "    n_total_files = sum(len(v) for v in ef.values())\n",
    "    if n_total_files == 0:\n",
    "        print(f\"\\n[{model_key}] No TXT files — skip\")\n",
    "        continue\n",
    "    \n",
    "    print(f\"\\n{'═'*60}\")\n",
    "    print(f\"  [{model_key}] Parsing {n_total_files} TXT files (hybrid + fullfea)...\")\n",
    "    print(f\"{'═'*60}\")\n",
    "    \n",
    "    model_HybFEA = {}\n",
    "    model_FullFEA = {}\n",
    "    model_winding_codes = []\n",
    "    model_fea_modes = {\"hybrid\": {}, \"fullfea\": {}}\n",
    "    first_parsed = True\n",
    "    \n",
    "    for folder_mode in [\"hybrid\", \"fullfea\"]:\n",
    "        mode_files = ef.get(folder_mode, {})\n",
    "        if not mode_files:\n",
    "            continue\n",
    "        \n",
    "        print(f\"\\n  ── [{folder_mode}] {len(mode_files)} speeds ──\")\n",
    "        \n",
    "        for si, (spd, txt_path) in enumerate(sorted(mode_files.items())):\n",
    "            print(f\"    {spd:>6} RPM: {txt_path.name}...\", end=\" \")\n",
    "            ts_parsed = get_magnetic_timeseries_from_file(str(txt_path), key=\"time_index\", verbose=False)\n",
    "            print(f\"✓ ({len(ts_parsed.steps)} steps)\", end=\"\")\n",
    "            \n",
    "            # 첫 파일에서 winding RegCode 식별 (모델당 1회)\n",
    "            if first_parsed:\n",
    "                first_parsed = False\n",
    "                mr0 = ts_parsed.by_step[ts_parsed.steps[0]]\n",
    "                print(f\"\\n      Regions: {len(mr0._regions)}, Nodes: {len(mr0.node_xy)}\")\n",
    "                print(f\"\\n      {'RegCode':>8} {'Elements':>10} {'Name'}\")\n",
    "                print(f\"      {'-'*50}\")\n",
    "                for reg in mr0._regions:\n",
    "                    n_el = len(reg.elements)\n",
    "                    if n_el == 0:\n",
    "                        continue\n",
    "                    has_current = any(abs(el.j) > 0.01 for el in reg.elements[:10])\n",
    "                    marker = \" ← WINDING\" if has_current else \"\"\n",
    "                    print(f\"      {reg.reg_code:>8} {n_el:>10} {reg.region_name}{marker}\")\n",
    "                    if has_current:\n",
    "                        model_winding_codes.append(reg.reg_code)\n",
    "                print(f\"\\n      ✓ Winding RegCodes: {model_winding_codes}\")\n",
    "            \n",
    "            # Je 기반 Hybrid/FullFEA 판별 (실제 데이터 기반)\n",
    "            if model_winding_codes:\n",
    "                detected_mode, je_max = detect_fea_mode(ts_parsed, model_winding_codes)\n",
    "                model_fea_modes[folder_mode][spd] = detected_mode\n",
    "                print(f\"  → {detected_mode} (max|Je|={je_max:.2f} A/mm²)\")\n",
    "                \n",
    "                # Je 감지 결과로 분류\n",
    "                if detected_mode == \"HYBRID\":\n",
    "                    model_HybFEA[spd] = ts_parsed\n",
    "                else:\n",
    "                    model_FullFEA[spd] = ts_parsed\n",
    "            else:\n",
    "                # winding code 미확인 → 폴더명 기반으로 분류\n",
    "                if folder_mode == \"hybrid\":\n",
    "                    model_HybFEA[spd] = ts_parsed\n",
    "                else:\n",
    "                    model_FullFEA[spd] = ts_parsed\n",
    "                print()\n",
    "    \n",
    "    all_winding_reg_codes[model_key] = model_winding_codes\n",
    "    all_HybFEA[model_key] = model_HybFEA\n",
    "    all_FullFEA[model_key] = model_FullFEA\n",
    "    all_fea_modes[model_key] = model_fea_modes\n",
    "    print(f\"\\n  → {model_key}: HybFEA={len(model_HybFEA)} speeds, \"\n",
    "          f\"FullFEA={len(model_FullFEA)} speeds\")\n",
    "\n",
    "# 기존 호환 변수\n",
    "winding_reg_codes = all_winding_reg_codes.get(\"ref\", [])\n",
    "# ts = 첫 모델의 첫 Hybrid 속도 (Cell 14 interactive 기본값)\n",
    "_first_model = next((k for k in [\"ref\", \"halfsc\", \"sc\"] if k in all_HybFEA and all_HybFEA[k]), None)\n",
    "if _first_model:\n",
    "    _first_speed = min(all_HybFEA[_first_model].keys())\n",
    "    ts = all_HybFEA[_first_model][_first_speed]\n",
    "\n",
    "# RegCode 일관성 확인\n",
    "codes_set = {mk: set(codes) for mk, codes in all_winding_reg_codes.items()}\n",
    "if len(codes_set) > 1 and len(set(frozenset(v) for v in codes_set.values())) == 1:\n",
    "    print(f\"\\n✓ 모델 모두 동일 RegCode: {winding_reg_codes}\")\n",
    "elif len(codes_set) > 1:\n",
    "    print(f\"\\n⚠ 모델별 RegCode 상이:\")\n",
    "    for mk, codes in all_winding_reg_codes.items():\n",
    "        print(f\"    {mk}: {codes}\")\n",
    "\n",
    "# FEA 모드 요약\n",
    "print(f\"\\n{'═'*60}\")\n",
    "print(f\"✓ FEA Mode Detection (Je-based):\")\n",
    "print(f\"  판별 기준: max|Je| > 0.1 A/mm² → FULLFEA, else → HYBRID\")\n",
    "for mk in all_fea_modes:\n",
    "    modes_data = all_fea_modes[mk]\n",
    "    for folder_mode, speed_modes in modes_data.items():\n",
    "        if speed_modes:\n",
    "            mode_set = set(speed_modes.values())\n",
    "            if len(mode_set) == 1:\n",
    "                print(f\"    {mk}/{folder_mode}: 전 속도 {mode_set.pop()}\")\n",
    "            else:\n",
    "                for spd, mode in sorted(speed_modes.items()):\n",
    "                    print(f\"    {mk}/{folder_mode}/{spd}RPM: {mode}\")\n",
    "\n",
    "print(f\"\\n{'═'*60}\")\n",
    "print(f\"✓ all_HybFEA / all_FullFEA 딕셔너리 생성 완료:\")\n",
    "for mk in set(list(all_HybFEA.keys()) + list(all_FullFEA.keys())):\n",
    "    hyb_speeds = sorted(all_HybFEA.get(mk, {}).keys())\n",
    "    full_speeds = sorted(all_FullFEA.get(mk, {}).keys())\n",
    "    print(f\"    all_HybFEA['{mk}']  → speeds: {hyb_speeds}\")\n",
    "    print(f\"    all_FullFEA['{mk}'] → speeds: {full_speeds}\")\n",
    "print(f\"\\n  사용법: all_HybFEA['halfsc'][8000].interactive_plot(quantity='b', cmap='jet')\")\n",
    "print(f\"          all_FullFEA['halfsc'][8000].interactive_plot(quantity='je', cmap='coolwarm')\")\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "c117bace",
   "metadata": {},
   "outputs": [
    {
     "ename": "NameError",
     "evalue": "name 'all_HybFEA' is not defined",
     "output_type": "error",
     "traceback": [
