   ],
   "source": [
    "# ─────────────────────────────────────────────────────────────────────────────\n",
    "# [5b] DXF 도체 polygon으로 mesh 요소 필터링\n",
    "# ─────────────────────────────────────────────────────────────────────────────\n",
    "# [5b] DXF 도체 polygon으로 mesh 요소 필터링\n",
    "# ───────────────────────────────────────────────────────────────────────────── \n",
    "import pickle\n",
    "from matplotlib.path import Path as MplPath\n",
    "\n",
    "# DXF에서 생성한 36개 도체(구리) polygon 로드\n",
    "pkl_path = Path(r\"D:\\KangDH\\EveryMotor\\eMach\\mlxperPJT\\JEET\\conductor_polygons_dxf.pkl\")\n",
    "with open(pkl_path, \"rb\") as f:\n",
    "    dxf_data = pickle.load(f)\n",
    "\n",
    "cond_polys = dxf_data[\"all_conductor_polygons_6slots\"]\n",
    "cond_paths = [MplPath(cp[\"vertices\"]) for cp in cond_polys]\n",
    "print(f\"Loaded {len(cond_polys)} conductor polygons from DXF\")\n",
    "print(f\"  Mean copper area: {np.mean([cp['area_mm2'] for cp in cond_polys]):.2f} mm²\")\n",
    "\n",
    "# bfield_data의 centroid로 필터링\n",
    "cx = bfield_data['centroid_x']  # [mm]\n",
    "cy = bfield_data['centroid_y']  # [mm]\n",
    "pts = np.column_stack([cx, cy])\n",
    "\n",
    "is_copper = np.zeros(len(cx), dtype=bool)\n",
    "for path in cond_paths:\n",
    "    is_copper |= path.contains_points(pts)\n",
    "\n",
    "n_total = len(cx)\n",
    "n_copper = is_copper.sum()\n",
    "n_insulation = n_total - n_copper\n",
    "\n",
    "# 면적 비교\n",
    "area_total = bfield_data['element_area_mm2'].sum()\n",
    "area_copper = bfield_data['element_area_mm2'][is_copper].sum()\n",
    "area_insulation = bfield_data['element_area_mm2'][~is_copper].sum()\n",
    "\n",
    "print(f\"\\n  Element classification:\")\n",
    "print(f\"    Total winding elements:     {n_total}\")\n",
    "print(f\"    Inside copper (DXF):        {n_copper} ({100*n_copper/n_total:.1f}%)\")\n",
    "print(f\"    Outside copper (insulation): {n_insulation} ({100*n_insulation/n_total:.1f}%)\")\n",
    "print(f\"\\n  Area breakdown:\")\n",
    "print(f\"    Total mesh area:   {area_total:.2f} mm²\")\n",
    "print(f\"    Copper mesh area:  {area_copper:.2f} mm² (expected ≈ {len(cond_polys)*13.9:.0f} mm²)\")\n",
    "print(f\"    Insulation area:   {area_insulation:.2f} mm²\")\n",
    "print(f\"    Copper fill ratio: {area_copper/area_total:.3f}\")\n",
    "\n",
    "# 시각화: 구리 vs 절연 영역\n",
    "fig, ax = plt.subplots(1, 1, figsize=(8, 8))\n",
    "ax.scatter(cx[~is_copper], cy[~is_copper], s=1, c='gray', alpha=0.3, label=f'Insulation ({n_insulation})')\n",
    "ax.scatter(cx[is_copper], cy[is_copper], s=1, c='red', alpha=0.5, label=f'Copper ({n_copper})')\n",
    "\n",
    "# Polygon outlines\n",
    "for cp in cond_polys:\n",
    "    verts = np.vstack([cp[\"vertices\"], cp[\"vertices\"][0]])  # close\n",
    "    ax.plot(verts[:, 0], verts[:, 1], 'b-', linewidth=0.5, alpha=0.5)\n",
    "\n",
    "ax.set_aspect('equal')\n",
    "ax.set_xlabel(\"x [mm]\")\n",
    "ax.set_ylabel(\"y [mm]\")\n",
    "ax.set_title(f\"DXF Conductor Filter: {n_copper}/{n_total} elements inside copper\")\n",
    "ax.legend(markerscale=5)\n",
    "ax.grid(True, alpha=0.2)\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "# bfield_data에 마스크 저장\n",
    "bfield_data['is_copper'] = is_copper\n",
    "print(f\"\\n✓ bfield_data['is_copper'] mask added — use for El Hajji calculation\")"
   ]
  },
