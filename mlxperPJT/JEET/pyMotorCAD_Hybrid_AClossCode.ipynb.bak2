    "    sc_ts_active = mat_data[\"sc_ts_ActiveOnly_kW\"].flatten()\n",
    "    \n",
    "    # ── Hybrid [kW] ──  (Ref / HalfSC / SC)\n",
    "    _ref_hyb_total = mat_data[\"ref_hybrid_Total_kW\"].flatten()\n",
    "    _ref_hyb_prox  = mat_data[\"ref_hybrid_Prox_kW\"].flatten()\n",
    "    _ref_hyb_skin  = mat_data[\"ref_hybrid_Skin_kW\"].flatten()\n",
    "    _hsc_hyb_total = mat_data[\"halfsc_hybrid_Total_kW\"].flatten()\n",
    "    _hsc_hyb_prox  = mat_data[\"halfsc_hybrid_Prox_kW\"].flatten()\n",
    "    _hsc_hyb_skin  = mat_data[\"halfsc_hybrid_Skin_kW\"].flatten()\n",
    "    _sc_hyb_total  = mat_data[\"sc_hybrid_Total_kW\"].flatten()\n",
    "    _sc_hyb_prox   = mat_data[\"sc_hybrid_Prox_kW\"].flatten()\n",
    "    _sc_hyb_skin   = mat_data[\"sc_hybrid_Skin_kW\"].flatten()\n",
    "    \n",
    "    # hybrid_results: Ref\n",
    "    hybrid_results = {}\n",
    "    for i, spd in enumerate(SPEED_LIST):\n",
    "        hybrid_results[spd] = {\n",
    "            \"total\": _ref_hyb_total[i] * 1000.0,\n",
    "            \"prox\": _ref_hyb_prox[i] * 1000.0,\n",
    "            \"skin\": _ref_hyb_skin[i] * 1000.0,\n",
    "        }\n",
    "    \n",
    "    # halfsc_hybrid_results\n",
    "    halfsc_hybrid_results = {}\n",
    "    for i, spd in enumerate(SPEED_LIST):\n",
    "        halfsc_hybrid_results[spd] = {\n",
    "            \"total\": _hsc_hyb_total[i] * 1000.0,\n",
    "            \"prox\": _hsc_hyb_prox[i] * 1000.0,\n",
    "            \"skin\": _hsc_hyb_skin[i] * 1000.0,\n",
    "        }\n",
    "    \n",
    "    # sc_hybrid_results\n",
    "    sc_hybrid_results = {}\n",
    "    for i, spd in enumerate(SPEED_LIST):\n",
    "        sc_hybrid_results[spd] = {\n",
    "            \"total\": _sc_hyb_total[i] * 1000.0,\n",
    "            \"prox\": _sc_hyb_prox[i] * 1000.0,\n",
    "            \"skin\": _sc_hyb_skin[i] * 1000.0,\n",
    "        }\n",
    "    \n",
    "    print(f\"\\n  Ref Hybrid [kW]:    {_ref_hyb_total}\")\n",
    "    print(f\"  HalfSC Hybrid [kW]: {_hsc_hyb_total}\")\n",
    "    print(f\"  SC Hybrid [kW]:     {_sc_hyb_total}\")\n",
    "    print(f\"  Ref TS [kW]:        {ref_ts_active}\")\n",
    "    print(f\"  HalfSC TS [kW]:     {halfsc_ts_active}\")\n",
    "    print(f\"  SC TS [kW]:         {sc_ts_active}\")\n",
    "else:\n",
    "    print(f\"  [WARN] MAT file not found: {MAT_PATH}\")\n",
    "    ref_ts_active = None\n",
    "    halfsc_ts_active = None\n",
    "    sc_ts_active = None\n",
    "    halfsc_hybrid_results = None\n",
    "    sc_hybrid_results = None"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "a610e54b",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 1400x1000 with 6 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "✓ Plot saved: D:\\KangDH\\Thesis\\e10\\SLFEA_Half\\Hybrid_ACloss_Export\\ElHajji_vs_Hybrid_TS_RefHalfSC.png\n"
     ]
    }
   ],
   "source": [
    "# ─────────────────────────────────────────────────────────────────────────────\n",
    "# [8b] 비교 Plot: MQS 셀21 스타일 4×2 (Ref / HalfSC / SC + 각 모델 El Hajji)\n",
    "# ─────────────────────────────────────────────────────────────────────────────\n",
    "\n",
    "speeds = np.array(SPEED_LIST)\n",
    "\n",
    "# El Hajji 결과 — 각 모델별\n",
    "def _elhajji_kw(model_key, field='P_total_corrected_W'):\n",
    "    res = all_el_hajji_results.get(model_key, {})\n",
    "    return np.array([res[s][field] / 1000.0 if s in res else 0.0 for s in SPEED_LIST])\n",
    "\n",
    "elhajji_ref_raw  = _elhajji_kw(\"ref\", \"P_total_W\")\n",
    "elhajji_ref_corr = _elhajji_kw(\"ref\", \"P_total_corrected_W\")\n",
    "elhajji_hsc_raw  = _elhajji_kw(\"halfsc\", \"P_total_W\")\n",
    "elhajji_hsc_corr = _elhajji_kw(\"halfsc\", \"P_total_corrected_W\")\n",
    "elhajji_sc_raw   = _elhajji_kw(\"sc\", \"P_total_W\")\n",
    "elhajji_sc_corr  = _elhajji_kw(\"sc\", \"P_total_corrected_W\")\n",
    "\n",
    "# Hybrid [kW]\n",
    "ref_hyb_kw = np.array([hybrid_results[s]['total'] / 1000.0 for s in SPEED_LIST])\n",
    "hsc_hyb_kw = np.array([halfsc_hybrid_results[s]['total'] / 1000.0 for s in SPEED_LIST])\n",
    "sc_hyb_kw  = np.array([sc_hybrid_results[s]['total'] / 1000.0 for s in SPEED_LIST])\n",
    "\n",
    "# ── Annotate helper ──\n",
    "def annotate_points(ax, x, y, fmt=\"{:.2f}\", offset=(4, 4), fontsize=6, color=\"black\"):\n",
    "    for xi, yi in zip(x, y):\n",
    "        ax.annotate(fmt.format(yi), xy=(xi, yi),\n",
    "                    xytext=offset, textcoords=\"offset points\",\n",
    "                    fontsize=fontsize, color=color, ha=\"left\")\n",
    "\n",
    "LEG_KW = dict(fontsize=6, loc=\"upper center\", bbox_to_anchor=(0.5, 1.0), ncol=1)\n",
    "\n",
    "# ── Figure: 4×2 (행: Ref / HalfSC / SC / Ratio 비교) ──\n",
    "fig, axes = plt.subplots(4, 2, figsize=(14, 18), sharex=True)\n",
    "fig.suptitle(\"AC Loss Comparison: Hybrid vs FEA-TS vs El Hajji 2D\\n\"\n",
    "             f\"(e10, I_ref={RMS_CURRENT}A, PA={PHASE_ADVANCE}°)\", fontsize=13, fontweight=\"bold\")\n",
    "\n",
    "# ═══════════════════════════════════════════════════════════════════════════════\n",
    "# [0,0] RefModel (k=1.0): AC Loss\n",
    "# ═══════════════════════════════════════════════════════════════════════════════\n",
    "ax = axes[0][0]\n",
    "ax.plot(speeds, ref_ts_active, \":\", marker=\"*\", color=\"blue\", label=\"Ref — TS\")\n",
    "ax.plot(speeds, ref_hyb_kw, \"-\", marker=\"o\", color=\"blue\", label=\"Ref — Hybrid\")\n",
    "ax.plot(speeds, elhajji_ref_raw, \"-^\", color=\"red\", label=\"El Hajji (raw)\")\n",
    "ax.plot(speeds, elhajji_ref_corr, \"-v\", color=\"darkred\", label=\"El Hajji (G_rect)\")\n",
    "annotate_points(ax, speeds, ref_ts_active, \"{:.2f}\", color=\"blue\")\n",
    "annotate_points(ax, speeds, ref_hyb_kw, \"{:.2f}\", offset=(4, -10), color=\"blue\")\n",
    "ax.set_ylabel(\"AC Loss [kW]\")\n",
    "ax.set_title(\"RefModel (k=1.0): AC Loss\")\n",
    "ax.legend(**LEG_KW)\n",
    "ax.grid(True, linestyle=\"--\", alpha=0.5)\n",
    "ax_t = ax.twinx()\n",
    "ts2hyb_ref = ref_ts_active / ref_hyb_kw\n",
    "ax_t.plot(speeds, ts2hyb_ref, \"--\", marker=\"d\", color=\"black\", label=\"Ref TS/Hybrid\")\n",
    "annotate_points(ax_t, speeds, ts2hyb_ref, \"{:.2f}\", offset=(4, 4), color=\"black\")\n",
    "ax_t.set_ylabel(\"TS/Hybrid ratio\")\n",
    "ax_t.legend(fontsize=6, loc=\"upper center\", bbox_to_anchor=(0.5, 0.88))\n",
    "\n",
    "# [0,1] RefModel: AC/DC ratio\n",
    "ax = axes[0][1]\n",
    "if mat_data is not None and \"ref_ts_DC_Active_kW\" in mat_data:\n",
    "    ref_dc = float(mat_data[\"ref_ts_DC_Active_kW\"].flat[0])\n",
    "    ref_ac_dc_ts = ref_ts_active / ref_dc\n",
    "    ref_ac_dc_hyb = ref_hyb_kw / ref_dc\n",
    "    ax.plot(speeds, ref_ac_dc_ts, \":\", marker=\"*\", color=\"blue\", label=\"Ref AC/DC (TS)\")\n",
    "    ax.plot(speeds, ref_ac_dc_hyb, \"-\", marker=\"o\", color=\"blue\", label=\"Ref AC/DC (Hybrid)\")\n",
    "    annotate_points(ax, speeds, ref_ac_dc_ts, \"{:.2f}\", color=\"blue\")\n",
    "    annotate_points(ax, speeds, ref_ac_dc_hyb, \"{:.2f}\", offset=(4, -10), color=\"blue\")\n",
    "else:\n",
    "    ax.text(0.5, 0.5, \"DC Loss\\nnot available\", ha=\"center\", va=\"center\",\n",
    "            transform=ax.transAxes, fontsize=10, color=\"gray\")\n",
    "ax.set_ylabel(\"AC/DC Loss Ratio\")\n",
    "ax.set_title(\"RefModel (k=1.0): AC/DC Ratio\")\n",
    "ax.legend(**LEG_KW)\n",
    "ax.grid(True, linestyle=\"--\", alpha=0.5)\n",
    "\n",
    "# ═══════════════════════════════════════════════════════════════════════════════\n",
    "# [1,0] HalfSCModel (k=1.5): AC Loss + El Hajji\n",
    "# ═══════════════════════════════════════════════════════════════════════════════\n",
    "ax = axes[1][0]\n",
    "ax.plot(speeds, halfsc_ts_active, \":\", marker=\"*\", color=\"green\", label=\"HalfSC — TS\")\n",
    "ax.plot(speeds, hsc_hyb_kw, \"-\", marker=\"o\", color=\"green\", label=\"HalfSC — Hybrid\")\n",
    "ax.plot(speeds, elhajji_hsc_raw, \"-^\", color=\"red\", label=\"El Hajji (raw)\")\n",
    "ax.plot(speeds, elhajji_hsc_corr, \"-v\", color=\"darkred\", label=\"El Hajji (G_rect)\")\n",
    "annotate_points(ax, speeds, halfsc_ts_active, \"{:.2f}\", color=\"green\")\n",
    "annotate_points(ax, speeds, hsc_hyb_kw, \"{:.2f}\", offset=(4, -10), color=\"green\")\n",
    "ax.set_ylabel(\"AC Loss [kW]\")\n",
    "ax.set_title(\"HalfSCModel (k=1.5): AC Loss\")\n",
    "ax.legend(**LEG_KW)\n",
    "ax.grid(True, linestyle=\"--\", alpha=0.5)\n",
    "ax_t = ax.twinx()\n",
    "ts2hyb_hsc = halfsc_ts_active / hsc_hyb_kw\n",
    "ax_t.plot(speeds, ts2hyb_hsc, \"--\", marker=\"d\", color=\"black\", label=\"HalfSC TS/Hybrid\")\n",
    "annotate_points(ax_t, speeds, ts2hyb_hsc, \"{:.2f}\", offset=(4, 4), color=\"black\")\n",
    "ax_t.set_ylabel(\"TS/Hybrid ratio\")\n",
    "ax_t.legend(fontsize=6, loc=\"upper center\", bbox_to_anchor=(0.5, 0.88))\n",
    "\n",
    "# [1,1] HalfSC: AC/DC ratio\n",
    "ax = axes[1][1]\n",
    "if mat_data is not None and \"halfsc_ts_DC_Active_kW\" in mat_data:\n",
    "    hsc_dc = float(mat_data[\"halfsc_ts_DC_Active_kW\"].flat[0])\n",
    "    hsc_ac_dc_ts = halfsc_ts_active / hsc_dc\n",
    "    hsc_ac_dc_hyb = hsc_hyb_kw / hsc_dc\n",
    "    ax.plot(speeds, hsc_ac_dc_ts, \":\", marker=\"*\", color=\"green\", label=\"HalfSC AC/DC (TS)\")\n",
    "    ax.plot(speeds, hsc_ac_dc_hyb, \"-\", marker=\"o\", color=\"green\", label=\"HalfSC AC/DC (Hybrid)\")\n",
    "    annotate_points(ax, speeds, hsc_ac_dc_ts, \"{:.2f}\", color=\"green\")\n",
    "    annotate_points(ax, speeds, hsc_ac_dc_hyb, \"{:.2f}\", offset=(4, -10), color=\"green\")\n",
    "else:\n",
    "    ax.text(0.5, 0.5, \"HalfSC DC Loss\\nnot available\", ha=\"center\", va=\"center\",\n",
    "            transform=ax.transAxes, fontsize=10, color=\"gray\")\n",
    "ax.set_ylabel(\"AC/DC Loss Ratio\")\n",
    "ax.set_title(\"HalfSCModel (k=1.5): AC/DC Ratio\")\n",
    "ax.legend(**LEG_KW)\n",
    "ax.grid(True, linestyle=\"--\", alpha=0.5)\n",
    "\n",
    "# ═══════════════════════════════════════════════════════════════════════════════\n",
    "# [2,0] SCModel (k=2.0): AC Loss + El Hajji\n",
    "# ═══════════════════════════════════════════════════════════════════════════════\n",
    "ax = axes[2][0]\n",
    "ax.plot(speeds, sc_ts_active, \":\", marker=\"*\", color=\"red\", label=\"SC — TS\")\n",
    "ax.plot(speeds, sc_hyb_kw, \"-\", marker=\"o\", color=\"red\", label=\"SC — Hybrid\")\n",
    "ax.plot(speeds, elhajji_sc_raw, \"-^\", color=\"orange\", label=\"El Hajji (raw)\")\n",
    "ax.plot(speeds, elhajji_sc_corr, \"-v\", color=\"darkorange\", label=\"El Hajji (G_rect)\")\n",
    "annotate_points(ax, speeds, sc_ts_active, \"{:.2f}\", color=\"red\")\n",
    "annotate_points(ax, speeds, sc_hyb_kw, \"{:.2f}\", offset=(4, -10), color=\"red\")\n",
    "ax.set_ylabel(\"AC Loss [kW]\")\n",
    "ax.set_title(\"SCModel (k=2.0): AC Loss\")\n",
    "ax.legend(**LEG_KW)\n",
    "ax.grid(True, linestyle=\"--\", alpha=0.5)\n",
    "ax_t = ax.twinx()\n",
    "ts2hyb_sc = sc_ts_active / sc_hyb_kw\n",
    "ax_t.plot(speeds, ts2hyb_sc, \"--\", marker=\"d\", color=\"black\", label=\"SC TS/Hybrid\")\n",
    "annotate_points(ax_t, speeds, ts2hyb_sc, \"{:.2f}\", offset=(4, 4), color=\"black\")\n",
    "ax_t.set_ylabel(\"TS/Hybrid ratio\")\n",
    "ax_t.legend(fontsize=6, loc=\"upper center\", bbox_to_anchor=(0.5, 0.88))\n",
    "\n",
    "# [2,1] SC: AC/DC ratio\n",
    "ax = axes[2][1]\n",
    "if mat_data is not None and \"sc_ts_DC_Active_kW\" in mat_data:\n",
    "    sc_dc = float(mat_data[\"sc_ts_DC_Active_kW\"].flat[0])\n",
    "    sc_ac_dc_ts = sc_ts_active / sc_dc\n",
    "    sc_ac_dc_hyb = sc_hyb_kw / sc_dc\n",
    "    ax.plot(speeds, sc_ac_dc_ts, \":\", marker=\"*\", color=\"red\", label=\"SC AC/DC (TS)\")\n",
    "    ax.plot(speeds, sc_ac_dc_hyb, \"-\", marker=\"o\", color=\"red\", label=\"SC AC/DC (Hybrid)\")\n",
    "    annotate_points(ax, speeds, sc_ac_dc_ts, \"{:.2f}\", color=\"red\")\n",
    "    annotate_points(ax, speeds, sc_ac_dc_hyb, \"{:.2f}\", offset=(4, -10), color=\"red\")\n",
    "else:\n",
    "    ax.text(0.5, 0.5, \"SC DC Loss\\nnot available\", ha=\"center\", va=\"center\",\n",
    "            transform=ax.transAxes, fontsize=10, color=\"gray\")\n",
    "ax.set_ylabel(\"AC/DC Loss Ratio\")\n",
    "ax.set_title(\"SCModel (k=2.0): AC/DC Ratio\")\n",
    "ax.legend(**LEG_KW)\n",
    "ax.grid(True, linestyle=\"--\", alpha=0.5)\n",
    "\n",
    "# ═══════════════════════════════════════════════════════════════════════════════\n",
    "# [3,0] El Hajji / Hybrid ratio (All models — 각 모델 자체 B-field)\n",
    "# ═══════════════════════════════════════════════════════════════════════════════\n",
    "ax = axes[3][0]\n",
    "ratio_ref  = elhajji_ref_corr / ref_hyb_kw\n",
    "ratio_hsc  = elhajji_hsc_corr / hsc_hyb_kw\n",
    "ratio_sc   = elhajji_sc_corr / sc_hyb_kw\n",
    "ax.plot(speeds, ratio_ref, \"-o\", color=\"blue\", label=\"Ref: El Hajji / Hybrid\")\n",
    "ax.plot(speeds, ratio_hsc, \"-s\", color=\"green\", label=\"HalfSC: El Hajji / Hybrid\")\n",
    "ax.plot(speeds, ratio_sc,  \"-^\", color=\"red\", label=\"SC: El Hajji / Hybrid\")\n",
    "annotate_points(ax, speeds, ratio_ref, \"{:.2f}\", color=\"blue\")\n",
    "annotate_points(ax, speeds, ratio_hsc, \"{:.2f}\", offset=(4, -10), color=\"green\")\n",
    "annotate_points(ax, speeds, ratio_sc, \"{:.2f}\", offset=(4, 4), color=\"red\")\n",
    "ax.axhline(1.0, color=\"gray\", linestyle=\"--\", alpha=0.5)\n",
    "ax.set_xlabel(\"Speed [RPM]\")\n",
    "ax.set_ylabel(\"El Hajji(G_rect) / Hybrid\")\n",
    "ax.set_title(\"El Hajji / Hybrid Ratio (Each Model's Own B)\")\n",
    "ax.legend(**LEG_KW)\n",
    "ax.grid(True, linestyle=\"--\", alpha=0.5)\n",
    "\n",
    "# [3,1] TS/Hybrid ratio (All models)\n",
    "ax = axes[3][1]\n",
    "ax.plot(speeds, ts2hyb_ref, \"--\", marker=\"d\", color=\"blue\", label=\"Ref TS/Hybrid\")\n",
    "ax.plot(speeds, ts2hyb_hsc, \"--\", marker=\"d\", color=\"green\", label=\"HalfSC TS/Hybrid\")\n",
    "ax.plot(speeds, ts2hyb_sc,  \"--\", marker=\"d\", color=\"red\", label=\"SC TS/Hybrid\")\n",
    "annotate_points(ax, speeds, ts2hyb_ref, \"{:.2f}\", color=\"blue\")\n",
    "annotate_points(ax, speeds, ts2hyb_hsc, \"{:.2f}\", offset=(4, -10), color=\"green\")\n",
    "annotate_points(ax, speeds, ts2hyb_sc, \"{:.2f}\", offset=(4, 4), color=\"red\")\n",
    "ax.axhline(1.0, color=\"gray\", linestyle=\"--\", alpha=0.5)\n",
    "ax.set_xlabel(\"Speed [RPM]\")\n",
    "ax.set_ylabel(\"TS/Hybrid ratio\")\n",
    "ax.set_title(\"TS/Hybrid Ratio (All Models)\")\n",
    "ax.legend(**LEG_KW)\n",
    "ax.grid(True, linestyle=\"--\", alpha=0.5)\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.savefig(str(export_dir / \"ElHajji_vs_Hybrid_TS_AllModels.png\"), dpi=150, bbox_inches=\"tight\")\n",
    "plt.show()\n",
    "print(f\"✓ Plot saved: {export_dir / 'ElHajji_vs_Hybrid_TS_AllModels.png'}\")"
   ]
  },
