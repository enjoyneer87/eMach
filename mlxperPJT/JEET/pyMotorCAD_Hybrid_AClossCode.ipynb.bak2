      "  [Ref (k=1.0)] e10Turn6V261.mot\n",
      "══════════════════════════════════════════════════════════════════════\n",
      "  Backup roots found: 3\n",
      "    • FEResultsData_backup\n",
      "    • FEResultsData_backup_MS\n",
      "    • FEResultsData_backup_unknown\n",
      "    ✓ FEResultsData_backup: hybrid=4, fullfea=0 speeds\n",
      "    [hybrid] 2000 RPM: FEResultsData/OnLoadTorque_result_1.mes → hybrid_ref_2000RPM.txt... ✓ (445880 KB)\n",
      "    [hybrid] 4000 RPM: FEResultsData/OnLoadTorque_result_1.mes → hybrid_ref_4000RPM.txt... ✓ (445880 KB)\n",
      "    [hybrid] 8000 RPM: FEResultsData/OnLoadTorque_result_1.mes → hybrid_ref_8000RPM.txt... ✓ (445880 KB)\n",
      "    [hybrid] 16000 RPM: FEResultsData/OnLoadTorque_result_1.mes → hybrid_ref_16000RPM.txt... ✓ (445880 KB)\n",
      "  → hybrid: 4 speeds, fullfea: 0 speeds\n",
      "\n",
      "══════════════════════════════════════════════════════════════════════\n",
      "  [HalfSC (k=1.5)] e10Turn6V261SLFEA_Half.mot\n",
      "══════════════════════════════════════════════════════════════════════\n",
      "  Backup roots found: 1\n",
      "    • FEResultsData_backup\n",
      "    ✓ FEResultsData_backup: hybrid=4, fullfea=4 speeds\n",
      "    [hybrid] 2000 RPM: Hybrid_HalfSC_Speed_2000RPM_20260610_020646/OnLoadTorque_result_1.mes → hybrid_halfsc_2000RPM.txt... ✓ (425156 KB)\n",
      "    [hybrid] 4000 RPM: Hybrid_HalfSC_Speed_4000RPM_20260610_020916/OnLoadTorque_result_1.mes → hybrid_halfsc_4000RPM.txt... ✓ (425156 KB)\n",
      "    [hybrid] 8000 RPM: Hybrid_HalfSC_Speed_8000RPM_20260610_021148/OnLoadTorque_result_1.mes → hybrid_halfsc_8000RPM.txt... ✓ (425156 KB)\n",
      "    [hybrid] 16000 RPM: Hybrid_HalfSC_Speed_16000RPM_20260610_021424/OnLoadTorque_result_1.mes → hybrid_halfsc_16000RPM.txt... ✓ (425156 KB)\n",
      "    [fullfea] 2000 RPM: TS_HalfSC_Speed_2000RPM_20260610_021902/OnLoadTorque_result_1.mes → fullfea_halfsc_2000RPM.txt... ✓ (483091 KB)\n",
      "    [fullfea] 4000 RPM: TS_HalfSC_Speed_4000RPM_20260610_022333/OnLoadTorque_result_1.mes → fullfea_halfsc_4000RPM.txt... ✓ (483091 KB)\n",
      "    [fullfea] 8000 RPM: TS_HalfSC_Speed_8000RPM_20260610_022810/OnLoadTorque_result_1.mes → fullfea_halfsc_8000RPM.txt... ✓ (483091 KB)\n",
      "    [fullfea] 16000 RPM: TS_HalfSC_Speed_16000RPM_20260610_023244/OnLoadTorque_result_1.mes → fullfea_halfsc_16000RPM.txt... ✓ (483091 KB)\n",
      "  → hybrid: 4 speeds, fullfea: 4 speeds\n",
      "\n",
      "══════════════════════════════════════════════════════════════════════\n",
      "  [SC (k=2.0)] e10Turn6V261SLFEA.mot\n",
      "══════════════════════════════════════════════════════════════════════\n",
      "  Backup roots found: 2\n",
      "    • FEResultsData_backup\n",
      "    • FEResultsData_backup_Hyb\n",
      "    ✓ FEResultsData_backup: hybrid=4, fullfea=0 speeds\n",
      "    [hybrid] 2000 RPM: FEResultsData/OnLoadTorque_result_1.mes → hybrid_sc_2000RPM.txt... ✓ (492626 KB)\n",
      "    [hybrid] 4000 RPM: FEResultsData/OnLoadTorque_result_1.mes → hybrid_sc_4000RPM.txt... ✓ (492626 KB)\n",
      "    [hybrid] 8000 RPM: FEResultsData/OnLoadTorque_result_1.mes → hybrid_sc_8000RPM.txt... ✓ (492626 KB)\n",
      "    [hybrid] 16000 RPM: FEResultsData/OnLoadTorque_result_1.mes → hybrid_sc_16000RPM.txt... ✓ (492626 KB)\n",
      "  → hybrid: 4 speeds, fullfea: 0 speeds\n",
      "\n",
      "══════════════════════════════════════════════════════════════════════\n",
      "✓ 전 모델 export 완료:\n",
      "    ref: hybrid=4 speeds, fullfea=0 speeds\n",
      "    halfsc: hybrid=4 speeds, fullfea=4 speeds\n",
      "    sc: hybrid=4 speeds, fullfea=0 speeds\n"
     ]
    }
   ],
   "source": [
    "# ─────────────────────────────────────────────────────────────────────────────\n",
    "# [3b-exec] 전 모델 .mes 검색 + TXT export (Hybrid + FullFEA 모두)\n",
    "#   - SC 모델은 FEResultsData_backup 없음 → 제외\n",
    "#   - FEResultsData_backup 우선, 없으면 FEResultsData_backup_* 변형 탐색\n",
    "#   - 이미 export된 TXT가 있으면 스킵 (재실행하려면 기존 TXT 삭제)\n",
    "#   - 폴더명 기반으로 Hybrid / FullFEA 구분하여 모두 export\n",
    "# ─────────────────────────────────────────────────────────────────────────────\n",
    "\n",
    "MODEL_CONFIGS = {\n",
    "    \"ref\": {\"mot_path\": Path(refMotFilePath), \"label\": \"Ref (k=1.0)\"},\n",
    "    \"halfsc\": {\"mot_path\": Path(HalfSCMotFilePath), \"label\": \"HalfSC (k=1.5)\"},\n",
    "    \"sc\": {\"mot_path\": Path(SCMotFilePath), \"label\": \"SC (k=2.0)\"},\n",
    "}\n",
    "\n",
    "def find_backup_roots(mot_path):\n",
    "    \"\"\"\n",
    "    .mot 파일 경로로부터 FEResultsData_backup* 폴더들을 우선순위대로 반환.\n",
    "    \"\"\"\n",
    "    mot_path = Path(mot_path)\n",
    "    model_dir = mot_path.parent / mot_path.stem\n",
    "    roots = []\n",
    "    exact = model_dir / \"FEResultsData_backup\"\n",
    "    if exact.exists():\n",
    "        roots.append(exact)\n",
    "    if model_dir.exists():\n",
    "        for d in sorted(model_dir.iterdir()):\n",
    "            if d.is_dir() and d.name.startswith(\"FEResultsData_backup_\"):\n",
    "                roots.append(d)\n",
    "    alt = mot_path.parent / \"FEResultsData_backup\"\n",
    "    if alt.exists() and alt not in roots:\n",
    "        roots.append(alt)\n",
    "    return roots\n",
    "\n",
    "\n",
    "def find_all_backup_mes_files(backup_root, speed_list=SPEED_LIST,\n",
    "                              mes_filename=\"OnLoadTorque_result_1.mes\"):\n",
    "    \"\"\"\n",
    "    FEResultsData_backup 하위에서 속도별 백업 .mes 파일을 모두 검색.\n",
    "    Hybrid/TS 폴더 구분하여 반환.\n",
    "    \n",
    "    Returns:\n",
    "        dict {\"hybrid\": {speed: Path}, \"fullfea\": {speed: Path}}\n",
    "    \"\"\"\n",
    "    backup_root = Path(backup_root)\n",
    "    if not backup_root.exists():\n",
    "        return {\"hybrid\": {}, \"fullfea\": {}}\n",
    "    \n",
    "    speed_set = set(speed_list)\n",
    "    rx_speed = re.compile(r\"Speed_(\\d+)RPM\", re.IGNORECASE)\n",
    "    \n",
    "    # {speed: [(folder, mes_path, is_hybrid, is_ts)]}\n",
    "    candidates = {s: [] for s in speed_list}\n",
    "    \n",
    "    for folder in backup_root.iterdir():\n",
    "        if not folder.is_dir():\n",
    "            continue\n",
    "        m = rx_speed.search(folder.name)\n",
    "        if not m:\n",
    "            continue\n",
    "        speed_val = int(m.group(1))\n",
    "        if speed_val not in speed_set:\n",
    "            continue\n",
    "        \n",
    "        # .mes 파일 찾기\n",
    "        mes_file = None\n",
    "        candidate = folder / mes_filename\n",
    "        if candidate.exists():\n",
    "            mes_file = candidate\n",
    "        if mes_file is None:\n",
    "            candidate = folder / \"FEResultsData\" / mes_filename\n",
    "            if candidate.exists():\n",
    "                mes_file = candidate\n",
    "        if mes_file is None:\n",
    "            found = list(folder.rglob(\"OnLoad*result*.mes\"))\n",
    "            if found:\n",
    "                mes_file = max(found, key=lambda p: p.stat().st_size)\n",
    "        if mes_file is None:\n",
    "            found = list(folder.rglob(\"*.mes\"))\n",
    "            if found:\n",
    "                mes_file = max(found, key=lambda p: p.stat().st_size)\n",
    "        \n",
    "        if mes_file is not None:\n",
    "            is_hybrid = folder.name.lower().startswith(\"hybrid\")\n",
    "            is_ts = folder.name.lower().startswith(\"ts\")\n",
    "            candidates[speed_val].append((folder, mes_file, is_hybrid, is_ts))\n",
    "    \n",
    "    # 분류: Hybrid / FullFEA(TS) / Unknown\n",
    "    result = {\"hybrid\": {}, \"fullfea\": {}}\n",
    "    for spd, entries in candidates.items():\n",
    "        if not entries:\n",
    "            continue\n",
    "        # 각 모드별 최신 선택\n",
    "        hybrid_entries = [e for e in entries if e[2]]      # is_hybrid=True\n",
    "        ts_entries = [e for e in entries if e[3]]          # is_ts=True\n",
    "        unknown_entries = [e for e in entries if not e[2] and not e[3]]\n",
    "        \n",
    "        # Hybrid: Hybrid_ 폴더 우선, 없으면 unknown을 Hybrid로 간주 (Ref 구조)\n",
    "        if hybrid_entries:\n",
    "            hybrid_entries.sort(key=lambda t: -t[0].stat().st_mtime)\n",
    "            result[\"hybrid\"][spd] = hybrid_entries[0][1]\n",
    "        elif unknown_entries:\n",
    "            unknown_entries.sort(key=lambda t: -t[0].stat().st_mtime)\n",
    "            result[\"hybrid\"][spd] = unknown_entries[0][1]\n",
    "        \n",
    "        # FullFEA: TS_ 폴더\n",
    "        if ts_entries:\n",
    "            ts_entries.sort(key=lambda t: -t[0].stat().st_mtime)\n",
    "            result[\"fullfea\"][spd] = ts_entries[0][1]\n",
    "    \n",
    "    return result\n",
    "\n",
    "\n",
    "# 결과 저장: {model_key: {\"hybrid\": {speed: Path(txt)}, \"fullfea\": {speed: Path(txt)}}}\n",
    "all_exported_files = {}\n",
    "\n",
    "for model_key, cfg in MODEL_CONFIGS.items():\n",
    "    mot = cfg[\"mot_path\"]\n",
    "    print(f\"\\n{'═'*70}\")\n",
    "    print(f\"  [{cfg['label']}] {mot.name}\")\n",
    "    print(f\"{'═'*70}\")\n",
    "    \n",
    "    model_result = {\"hybrid\": {}, \"fullfea\": {}}\n",
    "    \n",
    "    # ── 기존 export TXT 확인 ──\n",
    "    for fea_mode in [\"hybrid\", \"fullfea\"]:\n",
    "        model_export_dir = export_dir / model_key / fea_mode\n",
    "        if model_export_dir.exists():\n",
    "            for spd in SPEED_LIST:\n",
    "                txt_name = f\"{fea_mode}_{model_key}_{spd}RPM.txt\"\n",
    "                txt_path = model_export_dir / txt_name\n",
    "                if txt_path.exists() and txt_path.stat().st_size > 0:\n",
    "                    model_result[fea_mode][spd] = txt_path\n",
    "    \n",
    "    # 기존 TXT 전부 있는지 확인 (Hybrid만 체크 — FullFEA는 없을 수 있음)\n",
    "    existing_hybrid = model_result[\"hybrid\"]\n",
    "    existing_fullfea = model_result[\"fullfea\"]\n",
    "    \n",
    "    # Backup roots 탐색\n",
    "    backup_roots = find_backup_roots(mot)\n",
    "    print(f\"  Backup roots found: {len(backup_roots)}\")\n",
    "    for br in backup_roots:\n",
    "        print(f\"    • {br.name}\")\n",
    "    \n",
    "    # .mes 검색 (Hybrid + FullFEA 모두)\n",
    "    all_mes = {\"hybrid\": {}, \"fullfea\": {}}\n",
    "    for root in backup_roots:\n",
    "        found = find_all_backup_mes_files(root, SPEED_LIST)\n",
    "        for mode_key in [\"hybrid\", \"fullfea\"]:\n",
    "            if found[mode_key]:\n",
    "                # 기존에 없는 속도만 추가\n",
    "                for spd, mes_p in found[mode_key].items():\n",
    "                    if spd not in all_mes[mode_key]:\n",
    "                        all_mes[mode_key][spd] = mes_p\n",
    "        if all_mes[\"hybrid\"] or all_mes[\"fullfea\"]:\n",
    "            n_h = len(found[\"hybrid\"])\n",
    "            n_f = len(found[\"fullfea\"])\n",
    "            print(f\"    ✓ {root.name}: hybrid={n_h}, fullfea={n_f} speeds\")\n",
    "            break\n",
    "        else:\n",
    "            print(f\"    ✗ {root.name}: no matching speeds\")\n",
    "    \n",
    "    # 기존 TXT 전부 있으면 스킵\n",
    "    need_export = False\n",
    "    for mode_key in [\"hybrid\", \"fullfea\"]:\n",
    "        mes_for_mode = all_mes[mode_key]\n",
    "        existing_for_mode = model_result[mode_key]\n",
    "        missing = {s for s in mes_for_mode if s not in existing_for_mode}\n",
    "        if missing:\n",
    "            need_export = True\n",
    "    \n",
    "    if not need_export and (existing_hybrid or existing_fullfea):\n",
    "        print(f\"  ✓ 기존 TXT 발견 — export 스킵\")\n",
    "        for mode_key in [\"hybrid\", \"fullfea\"]:\n",
    "            if model_result[mode_key]:\n",
    "                print(f\"      [{mode_key}] {len(model_result[mode_key])} speeds\")\n",
    "        ed = export_dir / model_key\n",
    "        print(f\"  ※ 재export 하려면 폴더 삭제: {ed}\")\n",
    "        all_exported_files[model_key] = model_result\n",
    "        continue\n",
    "    \n",
    "    # Motor-CAD에 .mot 로드 (export 필요한 경우만)\n",
    "    if any(s not in model_result[mk] for mk in [\"hybrid\", \"fullfea\"] for s in all_mes[mk]):\n",
    "        mcad.load_from_file(str(mot))\n",
    "    \n",
    "    # .mes → TXT export (모드별)\n",
    "    for mode_key in [\"hybrid\", \"fullfea\"]:\n",
    "        mes_for_mode = all_mes[mode_key]\n",
    "        if not mes_for_mode:\n",
    "            continue\n",
    "        \n",
    "        mode_export_dir = export_dir / model_key / mode_key\n",
    "        mode_export_dir.mkdir(parents=True, exist_ok=True)\n",
    "        \n",
    "        for speed, mes_p in sorted(mes_for_mode.items()):\n",
    "            if speed in model_result[mode_key]:\n",
    "                continue  # 이미 있으면 스킵\n",
    "            \n",
    "            txt_name = f\"{mode_key}_{model_key}_{speed}RPM.txt\"\n",
    "            txt_path = mode_export_dir / txt_name\n",
    "            \n",
    "            print(f\"    [{mode_key}] {speed} RPM: {mes_p.parent.name}/{mes_p.name} → {txt_name}...\", end=\" \")\n",
    "            export_mes_to_txt(mcad, mes_p, txt_path,\n",
    "                              first_step=FIRST_STEP, final_step=FINAL_STEP,\n",
    "                              columns=EXPORT_COLUMNS)\n",
    "            model_result[mode_key][speed] = txt_path\n",
    "            print(f\"✓ ({txt_path.stat().st_size/1024:.0f} KB)\")\n",
    "    \n",
    "    all_exported_files[model_key] = model_result\n",
    "    print(f\"  → hybrid: {len(model_result['hybrid'])} speeds, \"\n",
    "          f\"fullfea: {len(model_result['fullfea'])} speeds\")\n",
    "\n",
    "# 기존 코드 호환 (Ref Hybrid)\n",
    "exported_files = all_exported_files.get(\"ref\", {}).get(\"hybrid\", {})\n",
    "\n",
    "print(f\"\\n{'═'*70}\")\n",
    "print(f\"✓ 전 모델 export 완료:\")\n",
    "for mk, ef in all_exported_files.items():\n",
    "    print(f\"    {mk}: hybrid={len(ef.get('hybrid',{}))} speeds, \"\n",
    "          f\"fullfea={len(ef.get('fullfea',{}))} speeds\")\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "3c_noload_md",
   "metadata": {},
   "source": "## [3c] No-Load (Open-Circuit Back-EMF) .mes → TXT Export\n\nMotor-CAD에서 수동으로 아래 설정 후 16000 RPM Back-EMF 계산을 실행한 결과를 TXT로 export:\n\n```python\nmcad.set_variable('BackEMFPointsPerCycle', 128)\nmcad.set_variable('BackEMFCalculation', 1)\n```\n\n입력 MES: `FEResultsData/OpenCircuitTransient_result_1.mes`  \n모델: HalfSC, 16000 RPM, 128 steps  \n출력: `export_dir/halfsc/noload/noload_halfsc_16000RPM.txt`  \n→ `pyMorisco_FFT_PEEC_Method34.ipynb` A3 셀에서 `ts_noload`로 로드 (FIX-1: PM-only i\\_mag)"
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "3c_noload_code",
   "metadata": {},
   "outputs": [],
   "source": "# ─────────────────────────────────────────────────────────────────────────────\n# [3c] No-Load (Open-Circuit Back-EMF) .mes → TXT Export\n#   - HalfSC 모델, 16000 RPM, BackEMFPointsPerCycle=128\n#   - Motor-CAD에서 수동 실행 후 저장된 MES 파일을 TXT로 export\n#   - export_mes_to_txt()는 셀 8([3b])에서 이미 정의됨\n# ─────────────────────────────────────────────────────────────────────────────\n\nNOLOAD_MES_PATH = Path(\n    r\"D:\\KangDH\\Thesis\\e10\\SLFEA_Half\\e10Turn6V261SLFEA_Half\"\n    r\"\\FEResultsData\\OpenCircuitTransient_result_1.mes\"\n)\nNOLOAD_SPEED_RPM = 16000\nNOLOAD_N_STEPS   = 128  # BackEMFPointsPerCycle\n\nnoload_txt_dir  = export_dir / \"halfsc\" / \"noload\"\nnoload_txt_path = noload_txt_dir / f\"noload_halfsc_{NOLOAD_SPEED_RPM}RPM.txt\"\n\nprint(f\"No-Load MES : {NOLOAD_MES_PATH}\")\nprint(f\"  exists    : {NOLOAD_MES_PATH.exists()}\")\nprint(f\"Output TXT  : {noload_txt_path}\")\n\nif noload_txt_path.exists() and noload_txt_path.stat().st_size > 0:\n    print(f\"✓ 이미 export됨 — 재실행하려면 파일 삭제: {noload_txt_path}\")\nelif not NOLOAD_MES_PATH.exists():\n    print(\"✗ MES 파일이 없습니다. Motor-CAD에서 아래 설정 후 BackEMF 계산을 먼저 실행하세요:\")\n    print(\"  mcad.set_variable('BackEMFPointsPerCycle', 128)\")\n    print(\"  mcad.set_variable('BackEMFCalculation', 1)\")\nelse:\n    mcad.load_from_file(str(Path(HalfSCMotFilePath)))\n    export_mes_to_txt(\n        mcad_obj     = mcad,\n        mes_path     = NOLOAD_MES_PATH,\n        txt_out_path = noload_txt_path,\n        first_step   = 1,\n        final_step   = NOLOAD_N_STEPS,\n        columns      = EXPORT_COLUMNS,\n    )\n    sz_kb = noload_txt_path.stat().st_size / 1024\n    print(f\"✓ Export 완료: {sz_kb:.0f} KB\")\n    print(\"  → pyMorisco_FFT_PEEC_Method34.ipynb A3 셀에서 이 경로를 사용하세요\")\n"
  },
