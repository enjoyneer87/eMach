   "source": [
    "# ─────────────────────────────────────────────────────────────────────────────\n",
    "# [4b] Interactive / Quiver plot — 모델·속도 선택\n",
    "# ─────────────────────────────────────────────────────────────────────────────\n",
    "# ── 여기서 모델과 속도를 바꿔가며 확인 ──\n",
    "PLOT_MODEL = \"ref\"      # \"ref\", \"halfsc\", \"sc\"\n",
    "PLOT_SPEED = 8000       # 2000, 4000, 8000, 16000\n",
    "PLOT_QTY   = \"b\"        # \"b\", \"bx\", \"by\", \"j\", \"a\"\n",
    "PLOT_FEA   = \"hybrid\"   # \"hybrid\" or \"fullfea\"\n",
    "\n",
    "_plot_dict = all_HybFEA if PLOT_FEA == \"hybrid\" else all_FullFEA\n",
    "ts_plot = _plot_dict[PLOT_MODEL][PLOT_SPEED]\n",
    "print(f\"[{PLOT_MODEL}/{PLOT_FEA}] {PLOT_SPEED} RPM — steps: {len(ts_plot.steps)}\")\n",
    "ts_plot.interactive_plot(quantity=PLOT_QTY, cmap=\"jet\")\n"
   ]
  },
