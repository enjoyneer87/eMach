      "    ref: [24, 25, 26, 27, 28, 29, 36, 37, 38, 39, 40, 83, 84, 85, 86, 87, 130, 131, 132, 133, 134, 177, 178, 179, 180, 181, 224, 225, 226, 227, 228, 271, 272, 273, 274, 275]\n",
      "    halfsc: [2, 3, 4, 5, 6, 7, 30, 31, 32, 33, 34, 77, 78, 79, 80, 81, 124, 125, 126, 127, 128, 171, 172, 173, 174, 175, 218, 219, 220, 221, 222, 265, 266, 267, 268, 269]\n",
      "    sc: [24, 25, 26, 27, 28, 29, 36, 37, 38, 39, 40, 83, 84, 85, 86, 87, 130, 131, 132, 133, 134, 177, 178, 179, 180, 181, 224, 225, 226, 227, 228, 271, 272, 273, 274, 275]\n",
