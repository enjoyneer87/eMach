   "source": [
    "# ─────────────────────────────────────────────────────────────────────────────\n",
    "# [7] 전 속도 El Hajji 2D 계산 실행 — Ref / HalfSC (모델별 + Hybrid/FullFEA)\n",
    "# ─────────────────────────────────────────────────────────────────────────────\n",
    "\n",
    "# DXF copper polygon: 현재 HalfSC 모델에 대해서만 생성됨\n",
    "# Ref 모델은 스케일 다르므로 별도 DXF 필요 → 없으면 RegCode-only (copper_mask=None)\n",
    "MODEL_COND_PATHS = {\n",
    "    \"halfsc\": cond_paths,  # 기존 DXF-based polygon\n",
    "    # \"ref\": None,         # TODO: Ref 모델 슬롯 DXF 생성 후 추가\n",
    "}\n",
    "\n",
    "def get_copper_mask_for_bdata(bdata, model_cond_paths):\n",
    "    \"\"\"bfield_data의 centroids에 대해 DXF copper polygon 기반 mask 생성.\"\"\"\n",
    "    if model_cond_paths is None:\n",
    "        return None  # DXF 없으면 전체 winding element 사용\n",
    "    cx = bdata['centroid_x']\n",
    "    cy = bdata['centroid_y']\n",
    "    pts = np.column_stack([cx, cy])\n",
    "    mask = np.zeros(len(cx), dtype=bool)\n",
    "    for path in model_cond_paths:\n",
    "        mask |= path.contains_points(pts)\n",
    "    return mask\n",
    "\n",
    "def run_el_hajji_for_model(model_key, fea_mode, exported_files_dict, all_winding_reg_codes, model_cond_paths_dict):\n",
    "    \"\"\"하나의 모델 + FEA 모드에 대해 전 속도 El Hajji 계산 실행.\n",
    "    \n",
    "    Args:\n",
    "        model_key: \"ref\", \"halfsc\", etc.\n",
    "        fea_mode: \"hybrid\" or \"fullfea\"\n",
    "        exported_files_dict: all_exported_files 전체 dict\n",
    "        all_winding_reg_codes: 모델별 RegCode dict\n",
    "        model_cond_paths_dict: 모델별 DXF polygon dict\n",
    "    \"\"\"\n",
    "    results = {}\n",
    "    ef = exported_files_dict.get(model_key, {}).get(fea_mode, {})\n",
    "    if not ef:\n",
    "        print(f\"  [{model_key}/{fea_mode}] No exported files — skipping\")\n",
    "        return results\n",
    "    \n",
    "    # 모델별 winding reg codes\n",
    "    wreg = all_winding_reg_codes.get(model_key, winding_reg_codes)\n",
    "    # 모델별 DXF polygon (없으면 None → copper_mask=None → 전체 winding 사용)\n",
    "    m_cond_paths = model_cond_paths_dict.get(model_key, None)\n",
    "    \n",
    "    mask_mode = \"DXF polygon\" if m_cond_paths is not None else \"RegCode-only (no DXF)\"\n",
    "    print(f\"\\n{'━'*60}\")\n",
    "    print(f\"  El Hajji 2D: {model_key}/{fea_mode} [{mask_mode}]\")\n",
    "    print(f\"{'━'*60}\")\n",
    "    \n",
    "    for speed in SPEED_LIST:\n",
    "        if speed not in ef:\n",
    "            print(f\"  [SKIP] {speed} RPM — no file\")\n",
    "            continue\n",
    "        \n",
    "        fe = speed_to_fe(speed)\n",
    "        txt_path = ef[speed]\n",
    "        ts_spd = get_magnetic_timeseries_from_file(str(txt_path), key=\"time_index\")\n",
    "        bdata = extract_conductor_bfield_timeseries(ts_spd, wreg)\n",
    "        \n",
    "        cu_mask = get_copper_mask_for_bdata(bdata, m_cond_paths)\n",
    "        \n",
    "        result = calculate_el_hajji_loss_2d(\n",
    "            bdata, f_e=fe, sigma=SIGMA_CU,\n",
    "            b_m=b_m, h_m=h_m, L_a=L_a,\n",
    "            n_harmonics=48, n_slots_model=6,\n",
    "            copper_mask=cu_mask,\n",
    "        )\n",
    "        \n",
    "        delta = 1.0 / np.sqrt(np.pi * fe * MU_0 * SIGMA_CU)\n",
    "        xi_val = h_m / delta\n",
    "        g_corr = G_rect(xi_val)\n",
    "        result['P_total_corrected_W'] = result['P_total_W'] * g_corr\n",
    "        result['G_rect'] = g_corr\n",
    "        result['xi'] = xi_val\n",
    "        result['mask_mode'] = mask_mode\n",
    "        result['fea_mode'] = fea_mode\n",
    "        \n",
    "        results[speed] = result\n",
    "        print(f\"  {speed:>6} RPM: El Hajji={result['P_total_W']:.1f} W, \"\n",
    "              f\"G_rect={result['P_total_corrected_W']:.1f} W  \"\n",
    "              f\"(elem: {result['n_copper_elements']})\")\n",
    "    \n",
    "    return results\n",
    "\n",
    "# ── Ref / HalfSC × Hybrid / FullFEA 계산 ──\n",
    "all_el_hajji_results = {}  # {model_key: {\"hybrid\": {speed: result}, \"fullfea\": {speed: result}}}\n",
    "for model_key in [\"ref\", \"halfsc\"]:\n",
    "    all_el_hajji_results[model_key] = {}\n",
    "    for fea_mode in [\"hybrid\", \"fullfea\"]:\n",
    "        res = run_el_hajji_for_model(\n",
    "            model_key, fea_mode, all_exported_files, all_winding_reg_codes, MODEL_COND_PATHS\n",
    "        )\n",
    "        if res:\n",
    "            all_el_hajji_results[model_key][fea_mode] = res\n",
    "\n",
    "# 기존 호환: el_hajji_results = ref/hybrid 결과\n",
    "el_hajji_results = all_el_hajji_results.get(\"ref\", {}).get(\"hybrid\", {})\n",
    "\n",
    "print(f\"\\n{'═'*60}\")\n",
    "print(f\"✓ El Hajji 계산 완료 (Ref / HalfSC × Hybrid / FullFEA)\")\n",
    "for mk, mode_results in all_el_hajji_results.items():\n",
    "    for fea_mode, res in mode_results.items():\n",
    "        if res:\n",
    "            spd0 = next(iter(res))\n",
    "            mode = res[spd0].get('mask_mode', '?')\n",
    "            total_kw = [res[s]['P_total_corrected_W']/1000.0 for s in SPEED_LIST if s in res]\n",
    "            print(f\"    {mk}/{fea_mode} ({mode}): {[f'{v:.3f}' for v in total_kw]} kW\")\n",
    "        else:\n",
    "            print(f\"    {mk}/{fea_mode}: NO DATA\")\n"
   ]
  },
