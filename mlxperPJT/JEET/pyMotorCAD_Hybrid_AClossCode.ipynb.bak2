  {
   "cell_type": "markdown",
   "id": "aa88aaf2",
   "metadata": {},
   "source": [
    "## [3b] FEResultsData_backup에서 .mes 파일 검색 → Motor-CAD 로드 → TXT export\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 63,
   "id": "0d0b7a4f",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "✓ find_backup_mes_files() 정의 완료\n",
      "  지원 구조:\n",
      "    A) Speed_{rpm}RPM/FEResultsData/OnLoadTorque_result_1.mes  (Ref)\n",
      "    B) Hybrid_*Speed_{rpm}RPM_*/OnLoadTorque_result_1.mes       (HalfSC)\n",
      "    C) *Speed_{rpm}RPM*/[rglob *.mes]                           (fallback)\n"
     ]
    }
   ],
   "source": [
    "# ─────────────────────────────────────────────────────────────────────────────\n",
    "# [3b] FEResultsData_backup에서 .mes 파일 검색 → Motor-CAD 로드 → TXT export\n",
    "# ─────────────────────────────────────────────────────────────────────────────\n",
    "import re\n",
    "\n",
    "def find_backup_mes_files(backup_root, speed_list=SPEED_LIST,\n",
    "                          mes_filename=\"OnLoadTorque_result_1.mes\",\n",
    "                          prefer_hybrid=True,\n",
    "                          latest_only=True):\n",
    "    \"\"\"\n",
    "    FEResultsData_backup 하위에서 속도별 백업 .mes 파일을 강건하게 검색.\n",
    "    \n",
    "    지원하는 폴더 구조:\n",
    "      구조 A (Ref): Speed_{rpm}RPM/FEResultsData/{mes_filename}\n",
    "      구조 B (HalfSC): Hybrid_*Speed_{rpm}RPM_*/  {mes_filename}\n",
    "      구조 C (일반):  *_{rpm}RPM*/  {mes_filename} or *.mes\n",
    "    \n",
    "    Args:\n",
    "        backup_root: FEResultsData_backup 경로\n",
    "        speed_list: 찾을 속도 목록 [RPM]\n",
    "        mes_filename: 선호하는 .mes 파일명 (가장 큰 파일 fallback)\n",
    "        prefer_hybrid: True면 Hybrid_ 폴더를 TS_ 폴더보다 우선\n",
    "        latest_only: True면 속도별 가장 최신 폴더만 반환\n",
    "    \n",
    "    Returns:\n",
    "        dict {speed_rpm: Path(.mes file)}\n",
    "    \"\"\"\n",
    "    backup_root = Path(backup_root)\n",
    "    if not backup_root.exists():\n",
    "        print(f\"  [WARN] Backup root not found: {backup_root}\")\n",
    "        return {}\n",
    "    \n",
    "    speed_set = set(speed_list)\n",
    "    # 속도를 폴더명에서 추출하는 패턴 (유연): *Speed_(\\d+)RPM* 또는 Speed_(\\d+)RPM\n",
    "    rx_speed = re.compile(r\"Speed_(\\d+)RPM\", re.IGNORECASE)\n",
    "    \n",
    "    candidates = {s: [] for s in speed_list}\n",
    "    \n",
    "    for folder in backup_root.iterdir():\n",
    "        if not folder.is_dir():\n",
    "            continue\n",
    "        \n",
    "        m = rx_speed.search(folder.name)\n",
    "        if not m:\n",
    "            continue\n",
    "        speed_val = int(m.group(1))\n",
    "        if speed_val not in speed_set:\n",
    "            continue\n",
    "        \n",
    "        # .mes 파일 찾기 — 여러 하위 구조 시도\n",
    "        mes_file = None\n",
    "        \n",
    "        # 1) 직접 폴더 내 선호 파일\n",
    "        candidate = folder / mes_filename\n",
    "        if candidate.exists():\n",
    "            mes_file = candidate\n",
    "        \n",
    "        # 2) FEResultsData 서브폴더 내 (구조 A)\n",
    "        if mes_file is None:\n",
    "            candidate = folder / \"FEResultsData\" / mes_filename\n",
    "            if candidate.exists():\n",
    "                mes_file = candidate\n",
    "        \n",
    "        # 3) glob fallback: 폴더 및 하위에서 OnLoad*result*.mes\n",
    "        if mes_file is None:\n",
    "            found = list(folder.rglob(\"OnLoad*result*.mes\"))\n",
    "            if found:\n",
    "                mes_file = max(found, key=lambda p: p.stat().st_size)\n",
    "        \n",
    "        # 4) 아무 .mes라도\n",
    "        if mes_file is None:\n",
    "            found = list(folder.rglob(\"*.mes\"))\n",
    "            if found:\n",
    "                mes_file = max(found, key=lambda p: p.stat().st_size)\n",
    "        \n",
    "        if mes_file is not None:\n",
    "            is_hybrid = folder.name.lower().startswith(\"hybrid\")\n",
    "            is_ts = folder.name.lower().startswith(\"ts\")\n",
    "            candidates[speed_val].append((folder, mes_file, is_hybrid, is_ts))\n",
    "    \n",
    "    # 우선순위 정렬: Hybrid 우선 → 최신 mtime\n",
    "    for s in candidates:\n",
    "        candidates[s].sort(key=lambda t: (\n",
    "            0 if (prefer_hybrid and t[2]) else (2 if t[3] else 1),  # hybrid=0, other=1, ts=2\n",
    "            -t[0].stat().st_mtime  # 최신 먼저\n",
    "        ))\n",
    "    \n",
    "    if latest_only:\n",
    "        return {s: paths[0][1] for s, paths in candidates.items() if paths}\n",
    "    else:\n",
    "        return {s: [p[1] for p in paths] for s, paths in candidates.items() if paths}\n",
    "\n",
    "\n",
    "def export_mes_to_txt(mcad_obj, mes_path, txt_out_path, first_step=1, final_step=45,\n",
    "                      columns=\"RegCode,Bx,By,A,J,Je\"):\n",
    "    \"\"\"\n",
    "    .mes 파일을 Motor-CAD에 로드한 뒤 TXT로 export.\n",
    "    \"\"\"\n",
    "    mes_path = Path(mes_path)\n",
    "    txt_out_path = Path(txt_out_path)\n",
    "    txt_out_path.parent.mkdir(parents=True, exist_ok=True)\n",
    "    \n",
    "    mcad_obj.load_fea_result(str(mes_path), 1)\n",
    "    mcad_obj.save_fea_data(str(txt_out_path), first_step, final_step, columns, \"\", \",\")\n",
    "    return txt_out_path\n",
    "\n",
    "\n",
    "print(\"✓ find_backup_mes_files() 정의 완료\")\n",
    "print(\"  지원 구조:\")\n",
    "print(\"    A) Speed_{rpm}RPM/FEResultsData/OnLoadTorque_result_1.mes  (Ref)\")\n",
    "print(\"    B) Hybrid_*Speed_{rpm}RPM_*/OnLoadTorque_result_1.mes       (HalfSC)\")\n",
    "print(\"    C) *Speed_{rpm}RPM*/[rglob *.mes]                           (fallback)\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 64,
   "id": "6dfdb558",
   "metadata": {},
   "outputs": [
    {
