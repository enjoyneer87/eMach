   "source": [
    "from tools.motorCAD.pyMCAD.b_locus import interactive_b_locus_field_plot\n",
    "\n",
    "# 전체 필드 locus (winding 영역만)\n",
    "interactive_b_locus_field_plot(ts_plot, reg_code=winding_reg_codes[0], element_stride=3)\n",
    "\n",
    "# 또는 단일 요소 locus\n",
    "MagElement.plot_b_locus_from_timeseries(ts_plot, tri_index=100, reg_code=winding_reg_codes[0])"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "5d66c613",
   "metadata": {},
   "outputs": [],
   "source": [
    "# ─────────────────────────────────────────────────────────────────────────────\n",
    "# [4c] Quiver (B-field vector) plot — 모델·속도·스텝 선택\n",
    "# ─────────────────────────────────────────────────────────────────────────────\n",
    "QUIV_MODEL = \"halfsc\"   # \"ref\", \"halfsc\", \"sc\"\n",
    "QUIV_SPEED = 8000       # RPM\n",
    "QUIV_STEP  = 1          # time step index (1-based)\n",
    "QUIV_FEA   = \"hybrid\"   # \"hybrid\" or \"fullfea\"\n",
    "\n",
    "_quiv_dict = all_HybFEA if QUIV_FEA == \"hybrid\" else all_FullFEA\n",
    "ts_q = _quiv_dict[QUIV_MODEL][QUIV_SPEED]\n",
    "mr_q = ts_q.by_step[ts_q.steps[QUIV_STEP - 1]]\n",
    "\n",
    "# 도체 영역 요소의 centroid + B vector 추출\n",
    "wreg_q = all_winding_reg_codes[QUIV_MODEL]\n",
    "cx_q, cy_q, bx_q, by_q = [], [], [], []\n",
    "for rc in wreg_q:\n",
    "    reg = mr_q._regions[rc - 1]\n",
    "    for el in reg.elements:\n",
    "        cxy = mr_q._element_centroid_xy(el)\n",
    "        if cxy is None:\n",
    "            continue\n",
    "        cx_q.append(cxy[0])\n",
    "        cy_q.append(cxy[1])\n",
    "        bx_q.append(el.bx if el.bx else 0.0)\n",
    "        by_q.append(el.by if el.by else 0.0)\n",
    "\n",
    "cx_q = np.array(cx_q)\n",
    "cy_q = np.array(cy_q)\n",
    "bx_q = np.array(bx_q)\n",
    "by_q = np.array(by_q)\n",
    "bmag_q = np.sqrt(bx_q**2 + by_q**2)\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(10, 10))\n",
    "sc = ax.quiver(cx_q, cy_q, bx_q, by_q, bmag_q,\n",
    "               cmap=\"jet\", scale=None, width=0.002, alpha=0.8)\n",
    "plt.colorbar(sc, ax=ax, label=\"|B| [T]\")\n",
    "ax.set_aspect(\"equal\")\n",
    "ax.set_xlabel(\"x [mm]\")\n",
    "ax.set_ylabel(\"y [mm]\")\n",
    "ax.set_title(f\"[{QUIV_MODEL}/{QUIV_FEA}] {QUIV_SPEED} RPM — Step {QUIV_STEP} — B-field Quiver (winding)\")\n",
    "ax.grid(True, alpha=0.2)\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "print(f\"  Elements plotted: {len(cx_q)}, |B| range: [{bmag_q.min():.4f}, {bmag_q.max():.4f}] T\")\n"
   ]
  },
