   "source": [
    "# ═══ [DIAG] EXP-1/2/3: Overestimate Root Cause Diagnosis ═══\n",
    "print(\"=\" * 70)\n",
    "print(\"EXP-2: i_mag MAGNITUDE ANALYSIS\")\n",
    "print(\"=\" * 70)\n",
    "\n",
    "# --- i_mag time series statistics ---\n",
    "i_rms_per_edge = np.sqrt(np.mean(i_mag_timeseries**2, axis=0))\n",
    "i_max_per_edge = np.abs(i_mag_timeseries).max(axis=0)\n",
    "print(f\"  i_mag_timeseries shape: {i_mag_timeseries.shape}  (steps x edges)\")\n",
    "print(f\"  Per-edge RMS:  mean={i_rms_per_edge.mean():.2f} A, max={i_rms_per_edge.max():.2f} A\")\n",
    "print(f\"  Per-edge peak: mean={i_max_per_edge.mean():.2f} A, max={i_max_per_edge.max():.2f} A\")\n",
    "\n",
    "# --- FFT phasor (fundamental) ---\n",
    "fund_amp = np.abs(I_mag_phasor[1])  # harmonic index 1 = fundamental\n",
    "print(f\"\\n  FFT fundamental (n=1):\")\n",
    "print(f\"    max |I_mag_phasor[1]| = {fund_amp.max():.2f} A\")\n",
    "print(f\"    mean |I_mag_phasor[1]| = {fund_amp.mean():.2f} A\")\n",
    "print(f\"    sum  |I_mag_phasor[1]| = {fund_amp.sum():.2f} A\")\n",
    "\n",
    "# --- Edge geometry ---\n",
    "print(f\"\\n  Edge geometry (slot-wall filtered, {n_mag_filtered} edges):\")\n",
    "print(f\"    edge_length mean = {edge_lengths_filt.mean()*1e3:.4f} mm\")\n",
    "print(f\"    edge_length max  = {edge_lengths_filt.max()*1e3:.4f} mm\")\n",
    "\n",
    "# --- Morisco comparison ---\n",
    "print(f\"\\n  Morisco Fig 5.12 reference (his miniature motor):\")\n",
    "print(f\"    His i_mag amplitudes: 0.01 - 0.6 A\")\n",
    "print(f\"    His conductor: ~1mm x 1mm, l=100mm, R_slot~5mm\")\n",
    "print(f\"    Our conductor: {cw_m*1e3:.2f}mm x {ch_m*1e3:.2f}mm, l={L_stack*1e3:.0f}mm\")\n",
    "print(f\"    Our i_mag fundamental max: {fund_amp.max():.2f} A\")\n",
    "\n",
    "# --- Check M values at boundary edges ---\n",
    "step_mid = n_steps // 4  # pick a step with significant field\n",
    "mx_mid = bx_ts_all[step_mid] / MU_0 - hx_ts_all[step_mid]\n",
    "my_mid = by_ts_all[step_mid] / MU_0 - hy_ts_all[step_mid]\n",
    "M_at_boundary = np.sqrt(mx_mid[iron_tri_filt]**2 + my_mid[iron_tri_filt]**2)\n",
    "print(f\"\\n  Magnetization at boundary edges (step {step_mid}):\")\n",
    "print(f\"    |M| mean = {M_at_boundary.mean():.0f} A/m\")\n",
    "print(f\"    |M| max  = {M_at_boundary.max():.0f} A/m\")\n",
    "print(f\"    |M|*mu0  = {MU_0*M_at_boundary.max():.3f} T (equivalent B)\")\n",
    "\n",
    "print(\"\\n\" + \"=\" * 70)\n",
    "print(\"EXP-1: Pure Morisco (Dirichlet circular L_mutual) vs L_ext (Rect)\")\n",
    "print(\"=\" * 70)\n",
    "\n",
    "# Compare L_mutual_mat (Dirichlet circular) vs L_ext (Rect image)\n",
    "print(f\"  L_mutual_mat shape: {L_mutual_mat.shape}  (Dirichlet circular, {n_mag_filtered} sources)\")\n",
    "print(f\"  L_ext shape:        {L_ext.shape}  (Rect image, {n_ext} sources)\")\n",
    "print(f\"  |L_mutual| stats: mean={np.abs(L_mutual_mat).mean():.4e}, max={np.abs(L_mutual_mat).max():.4e}\")\n",
    "print(f\"  |L_ext|     stats: mean={np.abs(L_ext).mean():.4e}, max={np.abs(L_ext).max():.4e}\")\n",
    "\n",
    "# --- EXP-1: PEEC solve with L_mutual_mat (Dirichlet) instead of L_ext ---\n",
    "print(f\"\\n  Running PEEC solve with L_mutual_mat (Dirichlet circular, uniform w=1)...\")\n",
    "i_harms_morisco = {}\n",
    "i_imp_morisco = None\n",
    "for nh_d in harmonic_indices:\n",
    "    omega_nd = nh_d * omega\n",
    "    Z_nd = R_matrix + 1j * omega_nd * L_matrix\n",
    "    Z_nd_inv = inv(Z_nd)\n",
    "    ZndC = Z_nd_inv @ C\n",
    "    CZndC = C.T @ ZndC\n",
    "    # Use L_mutual_mat (Dirichlet circular) with ORIGINAL slot-wall sources only\n",
    "    V_nd = 1j * omega_nd * (L_mutual_mat @ I_mag_phasor[nh_d])\n",
    "    i_raw_d = Z_nd_inv @ V_nd\n",
    "    i_corr_d = ZndC @ np_solve(CZndC, -(C.T @ i_raw_d))\n",
    "    if nh_d == 1:\n",
    "        i_imp_morisco = ZndC @ np_solve(CZndC, I_test)\n",
    "        i_harms_morisco[nh_d] = i_imp_morisco + i_raw_d + i_corr_d\n",
    "    else:\n",
    "        i_harms_morisco[nh_d] = i_raw_d + i_corr_d\n",
    "\n",
    "P_tot_morisco = sum(0.5 * R_fil * np.sum(np.abs(iv)**2) for iv in i_harms_morisco.values())\n",
    "k_ih_morisco = P_tot_morisco / P_dc\n",
    "J_eddy_morisco = np.abs(i_harms_morisco[1] - i_imp_morisco) / grid_local.area_fil * 1e-6\n",
    "v1_m = J_eddy_morisco[:n_fil_per].max()\n",
    "v6_m = J_eddy_morisco[-n_fil_per:].max()\n",
    "\n",
    "print(f\"\\n  === EXP-1 RESULT (Pure Morisco) ===\")\n",
    "print(f\"  L_mutual (Dirichlet circular, {n_mag_filtered} src, uniform):\")\n",
    "print(f\"    k_ih = {k_ih_morisco:.1f}  (current Method34: {list(results_g.values())[0]['k_ih']:.1f})\")\n",
    "print(f\"    C1={v1_m:.0f}, C6={v6_m:.0f} A/mm2, ratio={v1_m/max(v6_m,1e-6):.2f}x\")\n",
    "\n",
    "print(\"\\n\" + \"=\" * 70)\n",
    "print(\"EXP-3: V_mag SCALE ANALYSIS\")\n",
    "print(\"=\" * 70)\n",
    "# Check V_mag magnitude\n",
    "omega_1 = 1 * omega\n",
    "V_morisco = 1j * omega_1 * (L_mutual_mat @ I_mag_phasor[1])\n",
    "V_method34 = 1j * omega_1 * (L_ext @ I_mag_fft_ext[1])\n",
    "print(f\"  |V_mag| (Morisco circular):  mean={np.abs(V_morisco).mean():.4e}, max={np.abs(V_morisco).max():.4e}\")\n",
    "print(f\"  |V_mag| (Method34 rect):     mean={np.abs(V_method34).mean():.4e}, max={np.abs(V_method34).max():.4e}\")\n",
    "print(f\"  Ratio (Method34/Morisco):    {np.abs(V_method34).mean()/np.abs(V_morisco).mean():.2f}x\")\n",
    "\n",
    "# Check Z matrix scale (resistance vs inductance dominance)\n",
    "Z_1 = R_matrix + 1j * omega_1 * L_matrix\n",
    "R_diag = np.diag(R_matrix)\n",
    "L_diag = omega_1 * np.diag(L_matrix)\n",
    "print(f\"\\n  Z matrix at fundamental:\")\n",
    "print(f\"    R_fil = {R_diag[0]:.4f} Ohm\")\n",
    "print(f\"    omega*L_self = {L_diag[0]:.4f} Ohm\")\n",
    "print(f\"    omega*L/R ratio = {L_diag[0]/R_diag[0]:.4f} ({L_diag[0]/R_diag[0]*100:.2f}%)\")\n",
    "print(f\"    -> {'Resistance dominated' if L_diag[0]/R_diag[0] < 0.1 else 'Inductance significant'}\")\n",
    "\n",
    "print(f\"\\n  R_boundary = {R_boundary*1e3:.1f} mm\")\n",
    "print(f\"  L_stack = {L_stack*1e3:.1f} mm\")\n",
    "print(f\"  Morisco uses R = l (axial length) = {L_stack*1e3:.1f} mm\")\n",
    "print(f\"  Current R/l ratio = {R_boundary/L_stack:.2f}\")\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "f114647f",
